{
  "manifest_version": 3,
  "name": "VTOP Course Page Filter",
  "version": "1.3",
  "description": "Segregates VTOP Course Page Consolidated by Semester, Subject, and Faculty, and gives downloaded files clean names.",
  "permissions": ["downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://vtop.vit.ac.in/vtop/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://vtop.vit.ac.in/vtop/*"],
      "js": ["downloads.js"],
      "run_at": "document_idle"
    }
  ]
}